      "parameters": {
        "jsCode": "// Get file path from S3 list\nconst filePath = $input.first().json.Key\n\nconst parts = filePath.split(\".\")\nconst bucket = $env.S3_BUCKET_NAME\nconst extension = parts.pop()\nconst key = parts.join(\".\")\nconst metadataPath = `meta/${key}.json`;\n\nreturn {\n  key,\n  bucket,\n  extension,\n  filePath,\n  metadataPath,\n};"
