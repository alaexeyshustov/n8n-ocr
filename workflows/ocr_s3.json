    {
      "parameters": {
        "jsCode": "function replaceImagesInMarkdown(markdownStr, imagesDict) {\n    let result = markdownStr;\n    for (const [imgName, base64Str] of Object.entries(imagesDict)) {\n        const placeholder = `![${imgName}](${imgName})`;\n        const replacement = `![${imgName}](${base64Str})`;\n        result = result.replace(new RegExp(escapeRegExp(placeholder), 'g'), replacement);\n    }\n    return result;\n}\n\nfunction escapeRegExp(string) {\n    return string.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nfunction getCombinedMarkdown(ocrResponse) {\n    const markdowns = [];\n\n    // Extract images from each page\n    for (const page of ocrResponse.pages) {\n        const imageData = {};\n\n        // Build image dictionary for this page\n        if (page.images) {\n            for (const img of page.images) {\n                imageData[img.id] = img.image_base64;\n            }\n        }\n\n        // Replace image placeholders with actual images\n        markdowns.push(replaceImagesInMarkdown(page.markdown, imageData));\n    }\n\n    return markdowns.join('\\n\\n');\n}\n\nconst pages = $input.first()?.json?.pages || []\nconst markdown = pages.reduce(\n  (accumulator, page) => [accumulator, page.markdown].join(\"\\n\"), \"\",\n);\n\nconst fullMarkdonw = getCombinedMarkdown($input.first().json)\n\nreturn { \n  markdown,\n  fullMarkdonw,\n  size: $input.first().json.usage_info.doc_size_bytes\n};"
      },
